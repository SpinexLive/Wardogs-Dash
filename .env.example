PORT=3000
# development locally; set to production on the VPS (enables secure cookies + trusts the reverse proxy).
NODE_ENV=development

# Discord Developer Portal > Your App > OAuth2 > Client information
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Must exactly match a redirect registered in the Discord Developer Portal. On the VPS this is your
# real domain over https, e.g. https://dash.wardogs.tech/auth/discord/callback
DISCORD_CALLBACK_URL=http://localhost:3000/auth/discord/callback

# Your existing bot's token (Bot tab) and the ID of your server. The bot must already be a member of the guild.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=

# Comma-separated Discord role IDs that get full admin access the first time the app runs.
# More roles (admin or dashboard-only) can be granted later from the Settings page.
ADMIN_ROLE_IDS=

# Long random string used to sign session cookies. Generate one with:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-random-string

# Optional: Wardogs RCON API (https://wardogs.tech/rcon-reference), used only to check VIP
# (reserved slot) status on the Members page. Plain HTTP, full-access password - only point
# this at localhost or a tunnel/VPN to the game server, never expose the RCON port publicly.
RCON_HOST=127.0.0.1
RCON_PORT=7776
RCON_PASSWORD=
