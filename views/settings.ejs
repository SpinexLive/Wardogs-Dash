<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { title: 'Settings - Wardogs Dash' }) %>
</head>
<body>
  <%- include('partials/nav') %>

  <main class="page settings-page">
    <header class="dashboard-header">
      <div>
        <p class="eyebrow">Administration</p>
        <h1>Settings</h1>
        <p class="muted">Control access, roster membership, and rank assignments.</p>
      </div>
      <a href="/members" class="action-button">View roster</a>
    </header>

    <section class="dashboard-panel settings-panel">
      <% if (error) { %>
        <p class="error-banner"><%= error %></p>
      <% } %>
      <form method="POST" action="/settings/roles">
        <div class="settings-card-grid">
          <div class="select-group settings-card">
            <p class="eyebrow">Visibility</p><label>Dashboard Access Roles</label>
            <p class="fine-print">Members with any of these roles can view the dashboard.</p>
            <details class="role-dropdown">
              <summary>
                <span class="dropdown-count" data-count-for="allowedRoleIds"><%= access.allowedRoleIds.length %> selected</span>
              </summary>
              <div class="role-checklist" data-group="allowedRoleIds">
                <% roles.forEach((role) => { %>
                  <label class="role-option">
                    <input
                      type="checkbox"
                      name="allowedRoleIds"
                      value="<%= role.id %>"
                      <%= access.allowedRoleIds.includes(role.id) ? 'checked' : '' %>
                    />
                    <span class="role-pill" style="--role-color: #<%= role.color ? role.color.toString(16).padStart(6, '0') : '99aab5' %>">
                      <%= role.name %>
                    </span>
                  </label>
                <% }) %>
              </div>
            </details>
          </div>

          <div class="select-group settings-card">
            <p class="eyebrow">Control</p><label>Admin Access Roles</label>
            <p class="fine-print">Members with any of these roles can access Settings too.</p>
            <details class="role-dropdown">
              <summary>
                <span class="dropdown-count" data-count-for="adminRoleIds"><%= access.adminRoleIds.length %> selected</span>
              </summary>
              <div class="role-checklist" data-group="adminRoleIds">
                <% roles.forEach((role) => { %>
                  <label class="role-option">
                    <input
                      type="checkbox"
                      name="adminRoleIds"
                      value="<%= role.id %>"
                      <%= access.adminRoleIds.includes(role.id) ? 'checked' : '' %>
                    />
                    <span class="role-pill" style="--role-color: #<%= role.color ? role.color.toString(16).padStart(6, '0') : '99aab5' %>">
                      <%= role.name %>
                    </span>
                  </label>
                <% }) %>
              </div>
            </details>
          </div>

          <div class="select-group settings-card">
            <p class="eyebrow">Roster</p><label>Member Roles</label>
            <p class="fine-print">Roles that count as a "member" for the Members table below.</p>
            <details class="role-dropdown">
              <summary>
                <span class="dropdown-count" data-count-for="memberRoleIds"><%= access.memberRoleIds.length %> selected</span>
              </summary>
              <div class="role-checklist" data-group="memberRoleIds">
                <% roles.forEach((role) => { %>
                  <label class="role-option">
                    <input
                      type="checkbox"
                      name="memberRoleIds"
                      value="<%= role.id %>"
                      <%= access.memberRoleIds.includes(role.id) ? 'checked' : '' %>
                    />
                    <span class="role-pill" style="--role-color: #<%= role.color ? role.color.toString(16).padStart(6, '0') : '99aab5' %>">
                      <%= role.name %>
                    </span>
                  </label>
                <% }) %>
              </div>
            </details>
          </div>
        </div>

        <p class="fine-print">Admin access always includes dashboard access. Changes apply immediately, no re-login needed.</p>

        <div class="settings-card-grid settings-card-grid--two">
          <div class="select-group settings-card">
            <p class="eyebrow">Rank</p><label for="recruitRankRoleId">Recruit Role</label>
            <p class="fine-print">Shown as a "Recruit" badge under a member's name on the Members table.</p>
            <select id="recruitRankRoleId" name="recruitRankRoleId" class="role-select">
              <option value="">None</option>
              <% roles.forEach((role) => { %>
                <option value="<%= role.id %>" <%= access.recruitRankRoleId === role.id ? 'selected' : '' %>>
                  <%= role.name %>
                </option>
              <% }) %>
            </select>
          </div>

          <div class="select-group settings-card">
            <p class="eyebrow">Rank</p><label for="memberRankRoleId">Member Role</label>
            <p class="fine-print">Shown as a "Member" badge under a member's name on the Members table.</p>
            <select id="memberRankRoleId" name="memberRankRoleId" class="role-select">
              <option value="">None</option>
              <% roles.forEach((role) => { %>
                <option value="<%= role.id %>" <%= access.memberRankRoleId === role.id ? 'selected' : '' %>>
                  <%= role.name %>
                </option>
              <% }) %>
            </select>
          </div>
          <div class="select-group settings-card">
            <p class="eyebrow">Discord</p><label for="leaderboardChannelId">Leaderboard Channel</label>
            <p class="fine-print">Choose where the bot keeps one live, editable leaderboard embed.</p>
            <select id="leaderboardChannelId" name="leaderboardChannelId" class="role-select">
              <option value="">No channel selected</option>
              <% channels.forEach((channel) => { %>
                <option value="<%= channel.id %>" <%= access.leaderboardChannelId === channel.id ? 'selected' : '' %>># <%= channel.name %></option>
              <% }) %>
            </select>
          </div>
          <div class="select-group settings-card">
            <p class="eyebrow">Discord</p><label for="cashTotalChannelId">Live Cash Counter Channel</label>
            <p class="fine-print">The bot renames this text channel with the live total, for example: ┊💵┊＄3‚332‚878. Discord limits channel renames, so it refreshes at the next permitted interval (up to every five minutes).</p>
            <select id="cashTotalChannelId" name="cashTotalChannelId" class="role-select">
              <option value="">No channel selected</option>
              <% channels.forEach((channel) => { %>
                <option value="<%= channel.id %>" <%= access.cashTotalChannelId === channel.id ? 'selected' : '' %>># <%= channel.name %></option>
              <% }) %>
            </select>
          </div>
        </div>

        <div class="settings-actions">
          <button type="submit" class="btn-primary">Save Changes</button>
          <% if (saved) { %><span class="save-confirm">Saved!</span><% } %>
          <% if (typeof leaderboardSent !== 'undefined' && leaderboardSent) { %><span class="save-confirm">Leaderboard sent!</span><% } %>
        </div>
      </form>

      <div class="settings-actions" style="margin-top: 1rem">
        <form method="POST" action="/settings/leaderboard/send">
          <button type="submit" class="action-button">Send / refresh leaderboard</button>
        </form>
        <p class="fine-print">Save the selected channel first. Once sent, this same embed updates automatically after every 60-second server poll.</p>
      </div>
    </section>

    <section class="dashboard-panel settings-hint">
      <p class="eyebrow">Next step</p><h2>Members</h2>
      <p class="muted">
        Manage the member roster, Steam IDs, and stats on the
        <a href="/members" class="inline-link">Members page</a>.
      </p>
    </section>
  </main>
  <script src="/js/app.js"></script>
</body>
</html>
