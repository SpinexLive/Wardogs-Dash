<aside class="sidebar">
  <a href="/dashboard" class="brand">
    <img src="/images/wardogs-logo.png" alt="" class="brand-logo" />
    Wardogs Dash
  </a>
  <nav class="side-nav" aria-label="Primary navigation">
    <a href="/dashboard" class="<%= active === 'dashboard' ? 'active' : '' %>"><span aria-hidden="true">▦</span> Dashboard</a>
    <a href="/roster" class="<%= active === 'roster' ? 'active' : '' %>"><span aria-hidden="true">⚔</span> Roster</a>
    <a href="/briefing" class="<%= active === 'briefing' ? 'active' : '' %>"><span aria-hidden="true">▤</span> Briefings</a>
    <a href="/members" class="<%= active === 'members' ? 'active' : '' %>"><span aria-hidden="true">◉</span> Members</a>
    <% if (access.isAdmin) { %>
      <a href="/team-control" class="<%= active === 'team-control' ? 'active' : '' %>"><span aria-hidden="true">◫</span> 50v50 Control</a>
      <a href="/settings" class="<%= active === 'settings' ? 'active' : '' %>"><span aria-hidden="true">⚙</span> Settings</a>
      <a href="/bounty-hunter" class="<%= active === 'bounty-hunter' ? 'active' : '' %>"><span aria-hidden="true">$</span> Bounty Hunter</a>
    <% } %>
  </nav>
  <div class="user-chip sidebar-user">
    <img src="<%= user.avatar %>" alt="" />
    <span><%= user.username %></span>
    <a href="/auth/logout" class="logout">Logout</a>
  </div>
</aside>
