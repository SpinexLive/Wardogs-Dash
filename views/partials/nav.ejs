<header class="topbar">
  <a href="/dashboard" class="brand">
    <img src="/images/wardogs-logo.png" alt="" class="brand-logo" />
    Wardogs Dash
  </a>
  <nav class="topnav">
    <a href="/dashboard" class="<%= active === 'dashboard' ? 'active' : '' %>">Dashboard</a>
    <% if (access.isAdmin) { %>
      <a href="/members" class="<%= active === 'members' ? 'active' : '' %>">Members</a>
      <a href="/settings" class="<%= active === 'settings' ? 'active' : '' %>">Settings</a>
    <% } %>
  </nav>
  <div class="user-chip">
    <img src="<%= user.avatar %>" alt="" />
    <span><%= user.username %></span>
    <a href="/auth/logout" class="logout">Logout</a>
  </div>
</header>
