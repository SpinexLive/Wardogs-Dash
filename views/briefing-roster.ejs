<% const templateIcons = { infantry: '/images/infantry.png', armour: '/images/armour.png', fob: '/images/FOB.png', pilot: '/images/pilot.png', recon: '/images/recon.png', commander: '/images/wardogs.png' }; const slotIcon = (squad, player) => player.position < Number(squad.leader_slots || 0) ? '/images/squad leader.png' : (squad.template === 'fob' && player.position >= Number(squad.leader_slots || 0) + Number(squad.player_slots || 0) ? '/images/artillery.png' : templateIcons[squad.template] || '/images/infantry.png'); %>
<!DOCTYPE html>
<html lang="en"><head><%- include('partials/head', { title: 'Briefing - Wardogs Dash' }) %></head><body><%- include('partials/nav') %><main class="page briefing-roster-page" data-event-id="<%= roster.event_id %>"><header class="dashboard-header"><div><a class="back-link" href="/briefing">← Briefings</a><p class="eyebrow">Read-only roster</p><h1><%= roster.event_name %></h1><p class="muted"><%= new Intl.DateTimeFormat('en-GB', { timeZone: 'Europe/London', weekday: 'long', day: '2-digit', month: 'long', year: 'numeric', hour: '2-digit', minute: '2-digit', hour12: false }).format(new Date(roster.event_start * 1000)) %> · Europe/London</p></div><button id="check-attendance" class="action-button action-button--primary" type="button">Check attendance</button></header><p id="attendance-message" class="save-confirm" hidden></p><section class="dashboard-panel briefing-key"><span><i class="attendance-dot" data-state="unknown"></i> Discord channel</span><a href="https://ptb.discord.com/channels/1332320879073296404/<%= attendanceChannelId %>" target="_blank" rel="noreferrer">Open attendance channel</a></section><section class="briefing-squad-list"><% roster.squads.forEach((squad) => { %><article class="squad-card briefing-squad-card"><header><img src="<%= templateIcons[squad.template] || templateIcons.infantry %>" alt="" /><h2><%= squad.name %></h2></header><div class="briefing-player-list"><% if (!squad.assignments.length) { %><p class="empty-state">No players assigned.</p><% } %><% squad.assignments.forEach((player) => { %><div class="briefing-player" data-player-id="<%= player.player_id %>"><img src="<%= slotIcon(squad, player) %>" alt="" /><span><%= player.player_name %></span><div class="attendance-indicators" aria-label="Attendance status"><i class="attendance-dot" data-check="discord" data-state="unknown" title="Discord channel: unchecked"></i></div></div><% }) %></div></article><% }) %></section></main><script src="/js/briefing-roster.js"></script></body></html>
