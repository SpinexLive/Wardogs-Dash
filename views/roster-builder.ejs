<% const rosterBootstrap = JSON.stringify({ event, savedRoster }).replace(/</g, '\\u003c'); %>
<!DOCTYPE html><html lang="en"><head><%- include('partials/head', { title: 'Build Roster - Wardogs Dash' }) %></head><body class="roster-builder-body"><%- include('partials/nav') %><main class="page roster-builder-page" data-event-id="<%= event.id %>"><header class="dashboard-header"><div><a class="back-link" href="/roster">← Rosters</a><p class="eyebrow">Scheduled Match</p><h1><%= event.name %></h1><p class="muted" id="event-time"></p></div><button id="save-roster" class="action-button action-button--primary">Save Roster</button></header><p id="roster-message" class="save-confirm" hidden></p><div class="roster-builder-layout"><aside class="dashboard-panel player-column"><div class="panel-heading"><div><p class="eyebrow">Player List</p><h2><%= event.players.length %> signed up</h2></div></div><input class="member-search" id="player-search" type="search" placeholder="Search players..." /><div class="role-filter" id="role-filter"><button data-role="all" class="active">All</button><button data-role="infantry">Infantry</button><button data-role="armour">Armour</button><button data-role="pilot">Pilot</button><button data-role="fob">FOB</button><button data-role="commander">Commander</button></div><div class="player-list drag-drop-container" id="player-list"></div></aside><section class="dashboard-panel squad-column"><div class="squad-topbar"><div><p class="eyebrow">Squad Builder</p><h2>Build team</h2></div><div><strong id="slot-counter">0 / 33</strong><span> players assigned</span></div></div><div class="warning-banner" id="slot-warning" hidden></div><div class="template-bar" id="template-bar"><button data-template="infantry"><img src="/images/infantry.png" alt="" />Infantry</button><button data-template="armour"><img src="/images/armour.png" alt="" />Armour</button><button data-template="fob"><img src="/images/FOB.png" alt="" />FOB</button><button data-template="pilot"><img src="/images/pilot.png" alt="" />Pilot</button><button data-template="recon"><img src="/images/recon.png" alt="" />Recon</button><button data-template="commander"><img src="/images/wardogs.png" alt="" />Commander</button></div><p class="slot-remaining" id="slot-remaining"></p><div id="squad-list" class="squad-list drag-drop-container"></div></section></div></main><script>window.rosterBootstrap = <%- rosterBootstrap %>;</script><script src="/js/roster-builder.js"></script></body></html>
