<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/head', { title: 'Dashboard - Wardogs Dash' }) %>
</head>
<body>
  <%- include('partials/nav') %>
  <main class="page dashboard-page">
    <header class="dashboard-header">
      <div>
        <p class="eyebrow">Operations overview</p>
        <h1>Wardogs Command</h1>
        <p class="muted">Live roster, attendance, and competitive performance.</p>
      </div>
      <div class="header-actions">
        <%- include('partials/action-button', { href: '/members', label: 'Manage roster', primary: false }) %>
        <form method="POST" action="/dashboard/update-vip"><button type="submit" class="action-button action-button--primary">Sync VIP slots</button></form>
      </div>
    </header>

    <% if (vipSuccess) { %><p class="save-confirm"><%= vipSuccess %></p><% } %>
    <% if (vipError) { %><p class="error-banner"><%= vipError %></p><% } %>

    <section class="metric-grid">
      <%- include('partials/metric-card', { label: 'Active roster', value: dashboard.metrics.rosterCount, detail: 'Configured member roles' }) %>
      <%- include('partials/metric-card', { label: 'Ranked members', value: dashboard.metrics.memberRanked, detail: 'Holding the Member rank' }) %>
      <%- include('partials/metric-card', { label: 'Steam linked', value: dashboard.metrics.steamCoverage + '%', detail: dashboard.metrics.steamLinked + ' roster records linked' }) %>
      <%- include('partials/metric-card', { label: 'VIP ready', value: dashboard.metrics.vipEligible, detail: 'Eligible players with Steam IDs' }) %>
      <%- include('partials/metric-card', { label: 'On the server', value: dashboard.metrics.serverPlayers === null ? '—' : dashboard.metrics.serverPlayers + (dashboard.metrics.serverCapacity ? ' / ' + dashboard.metrics.serverCapacity : ''), detail: dashboard.metrics.serverPlayers === null ? 'RCON server unavailable' : 'Live game-server player count' }) %>
      <%- include('partials/metric-card', { label: 'Cash earned', value: '$' + dashboard.metrics.cashEarned.toLocaleString(), detail: 'Tracked gains across all players', cardClass: 'metric-card--cash' }) %>
    </section>

    <section class="dashboard-columns">
      <section class="dashboard-panel dashboard-panel--wide">
        <div class="panel-heading"><div><p class="eyebrow">Competitive</p><h2>Match history</h2></div><span class="status-pill"><%= dashboard.metrics.matchesPlayed %> recorded</span></div>
        <% if (dashboard.matches.length) { %>
          <div class="activity-list">
            <% dashboard.matches.forEach((match) => { %>
              <article class="activity-row"><span class="result-dot result-dot--<%= match.result %>"></span><div><strong>vs <%= match.opponent || 'Unknown opponent' %></strong><p><%= match.score || 'Score pending' %> · <%= match.date || 'Date pending' %></p></div><span class="match-result"><%= match.result || 'pending' %></span></article>
            <% }) %>
          </div>
        <% } else { %><p class="empty-state">No match records have been stored yet.</p><% } %>
      </section>
      <section class="dashboard-panel briefing-create-card">
        <div class="panel-heading"><div><p class="eyebrow">Readiness</p><h2>Create briefing</h2></div></div>
        <p class="muted">Open an upcoming saved roster and check who is in the briefing channel and on the game server.</p>
        <a href="/briefing" class="action-button action-button--primary">Create briefing</a>
      </section>
    </section>

    <section class="dashboard-columns dashboard-columns--bottom">
      <section class="dashboard-panel kpi-panel">
        <div class="panel-heading"><div><p class="eyebrow">Warcon performance</p><h2>Average clan stats</h2></div><span class="status-pill <%= dashboard.metrics.clanAverages ? '' : 'status-pill--muted' %>"><%= dashboard.metrics.clanAverages ? dashboard.metrics.clanAverages.tracked + ' tracked' : 'No data' %></span></div>
        <% if (dashboard.metrics.clanAverages) { const averages = dashboard.metrics.clanAverages; %>
          <div class="kpi-grid clan-average-grid"><div><span>Avg kills</span><strong><%= averages.kills.toFixed(1) %></strong></div><div><span>Avg deaths</span><strong><%= averages.deaths.toFixed(1) %></strong></div><div><span>Clan K/D</span><strong><%= averages.kd.toFixed(2) %></strong></div><div><span>Avg sessions</span><strong><%= averages.sessions.toFixed(1) %></strong></div><div><span>Avg playtime</span><strong><%= Math.round(averages.minutes) %>m</strong></div><div><span>Clan KPM</span><strong><%= averages.kpm.toFixed(2) %></strong></div></div>
        <% } else { %><p class="empty-state">Warcon performance data will appear once its API key and server ID are configured.</p><% } %>
      </section>
      <section class="dashboard-panel kpi-panel">
        <p class="eyebrow">Clan performance</p><h2>Performance KPIs</h2>
        <div class="kpi-grid"><div><span>Win rate</span><strong><%= dashboard.metrics.winRate === null ? '—' : dashboard.metrics.winRate + '%' %></strong></div><div><span>Matches</span><strong><%= dashboard.metrics.matchesPlayed %></strong></div><div><span>Attendance</span><strong><%= dashboard.metrics.attendanceRate === null ? '—' : dashboard.metrics.attendanceRate + '%' %></strong></div></div>
      </section>
    </section>
  </main>
</body>
</html>
