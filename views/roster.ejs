<% const formatTime = (timestamp) => new Intl.DateTimeFormat('en-GB', { timeZone: 'Europe/London', weekday: 'short', day: '2-digit', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit', hour12: false }).format(new Date(timestamp * 1000)); %>
<!DOCTYPE html><html lang="en"><head><%- include('partials/head', { title: 'Rosters - Wardogs Dash' }) %></head><body><%- include('partials/nav') %><main class="page roster-page"><header class="dashboard-header"><div><p class="eyebrow">Raid-Helper</p><h1>Rosters</h1><p class="muted">Upcoming matches, ordered by their London start time.</p></div><span class="status-pill"><%= events.length %> upcoming</span></header><% if (error) { %><p class="error-banner"><%= error %></p><% } %><% if (!events.length) { %><section class="dashboard-panel empty-panel"><h2>No upcoming matches</h2><p class="muted">No future Raid-Helper events beginning with ⚔️ were found.</p></section><% } else { %><%- include('partials/event-list', { events, formatTime }) %><% } %></main></body></html>
