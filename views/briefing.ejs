<!DOCTYPE html>
<html lang="en"><head><%- include('partials/head', { title: 'Briefings - Wardogs Dash' }) %></head><body><%- include('partials/nav') %><main class="page briefing-page"><header class="dashboard-header"><div><p class="eyebrow">Operations readiness</p><h1>Briefings</h1><p class="muted">Choose an upcoming saved roster to check Discord and game-server attendance.</p></div></header><% if (!rosters.length) { %><section class="dashboard-panel empty-panel"><h2>No upcoming saved rosters</h2><p class="muted">Save a future roster before creating its briefing.</p><a class="action-button action-button--primary" href="/roster">Open rosters</a></section><% } else { %><section class="roster-event-grid"><% rosters.forEach((roster) => { %><article class="roster-event-card briefing-event-card"><p class="eyebrow">Saved roster</p><h2><%= roster.event_name %></h2><p class="event-date"><%= new Intl.DateTimeFormat('en-GB', { timeZone: 'Europe/London', weekday: 'long', day: '2-digit', month: 'long', year: 'numeric', hour: '2-digit', minute: '2-digit', hour12: false }).format(new Date(roster.event_start * 1000)) %></p><footer><span>Updated <%= new Date(roster.updated_at + 'Z').toLocaleDateString('en-GB') %></span><a class="action-button action-button--primary" href="/briefing/<%= roster.event_id %>">Open briefing</a></footer></article><% }) %></section><% } %></main></body></html>
